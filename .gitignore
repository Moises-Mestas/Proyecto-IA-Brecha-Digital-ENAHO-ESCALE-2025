# ===== Entorno local y archivos temporales (no entregar) =====
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.env
.env.*
.DS_Store
Thumbs.db
~$*
*.tmp

# ===== Salidas auxiliares del experimento =====
